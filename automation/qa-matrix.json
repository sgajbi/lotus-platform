{
    "repositories":  [
                         {
                             "repo":  "lotus-gateway",
                             "startup":  {
                                             "up_command":  "docker compose up -d --build lotus-gateway",
                                             "down_command":  "docker compose down",
                                             "log_command":  "docker compose logs --tail=200 lotus-gateway"
                                         },
                             "checks":  {
                                            "api":  [
                                                        {
                                                            "id":  "health",
                                                            "method":  "GET",
                                                            "url":  "http://gateway.dev.lotus/health",
                                                            "expected_status":  200,
                                                            "must_contain":  [
                                                                                 "status"
                                                                             ]
                                                        },
                                                        {
                                                            "id":  "docs",
                                                            "method":  "GET",
                                                            "url":  "http://gateway.dev.lotus/docs",
                                                            "expected_status":  200,
                                                            "must_contain":  [
                                                                                 "Swagger"
                                                                             ]
                                                        }
                                                    ],
                                            "monitoring":  [
                                                               {
                                                                   "id":  "metrics",
                                                                   "url":  "http://gateway.dev.lotus/metrics",
                                                                   "expected_status":  200,
                                                                   "must_contain":  [
                                                                                        "http"
                                                                                    ]
                                                               }
                                                           ],
                                            "observability":  {
                                                                  "require_response_headers":  [
                                                                                                   "x-correlation-id"
                                                                                               ],
                                                                  "required_log_patterns":  [
                                                                                                "correlation",
                                                                                                "latency_ms",
                                                                                                "service"
                                                                                            ]
                                                              }
                                        }
                         },
