    },
    "fixed_local": {
      "label": "status/fixed-local",
      "aliases": ["status/fixed-locally", "status:fixed-local", "status:fixed-locally"]
    },
    "pr_open": {
      "label": "status/pr-open",
      "aliases": ["status:pr-open"]
    },
    "merged_main": {
      "label": "status/merged-main",
      "aliases": ["status/merged-to-main", "status:merged-main", "status:merged-to-main"]
