{
  "contract_id": "analytics-ui-observability-contract",
  "contract_version": "0.1.0",
  "governed_by_rfc": "RFC-0108",
  "lifecycle_status": "slice-4-structured-logging-implemented",
  "allowed_labels": [
    "route",
    "panel",
    "service",
    "operation",
    "state",
    "reason",
    "freshness_bucket",
    "supportability_state",
    "attention_type",
    "severity",
    "status_class",
    "error_category",
    "region",
    "environment"
  ],
  "forbidden_fields": [
    "portfolio_id",
    "client_id",
    "client_name",
    "household_id",
    "account_id",
    "instrument_id",
    "holding_id",
    "transaction_id",
    "trace_id",
    "correlation_id",
    "document_id",
    "advisor_id",
    "advisor_behavior",
    "screen_content",
    "request_body",
    "response_body",
    "raw_entitlement_failure"
  ],
  "state_vocabulary": [
    "loading",
    "ready",
    "empty",
    "partial",
    "stale",
    "degraded",
    "error",
    "permission_blocked",
    "unsupported"
  ],
  "metric_families": [
    {
      "metric_name": "lotus_workbench_panel_hydration_duration_seconds",
      "owner_repo": "lotus-workbench",
      "implemented": false,
      "metric_type": "histogram",
      "labels": ["route", "panel", "state", "freshness_bucket"],
      "purpose": "planned panel hydration duration metric for certified Workbench analytics panels"
    },
    {
      "metric_name": "lotus_workbench_panel_state_total",
      "owner_repo": "lotus-workbench",
      "implemented": false,
      "metric_type": "counter",
      "labels": ["route", "panel", "state", "reason"],
      "purpose": "planned bounded state transition counter for certified analytics panels"
    },
    {
      "metric_name": "lotus_workbench_api_request_duration_seconds",
      "owner_repo": "lotus-workbench",
      "implemented": false,
      "metric_type": "histogram",
      "labels": ["route", "operation", "status_class"],
      "purpose": "planned Workbench BFF/API request duration metric"
    },
    {
      "metric_name": "lotus_gateway_analytics_fanout_duration_seconds",
      "owner_repo": "lotus-gateway",
      "implemented": false,
      "metric_type": "histogram",
      "labels": ["operation", "service", "status_class"],
      "purpose": "planned gateway analytics fan-out duration metric"
    },
    {
      "metric_name": "lotus_gateway_analytics_degraded_total",
      "owner_repo": "lotus-gateway",
      "implemented": false,
      "metric_type": "counter",
      "labels": ["operation", "service", "reason"],
      "purpose": "planned gateway analytics degraded-source counter"
    },
    {
      "metric_name": "lotus_analytics_freshness_bucket_total",
      "owner_repo": "lotus-performance/lotus-risk",
      "implemented": false,
      "metric_type": "counter",
      "labels": ["service", "operation", "freshness_bucket", "supportability_state"],
      "purpose": "planned backend analytics freshness and supportability counter"
    },
    {
      "metric_name": "lotus_analytics_ui_attention_events_total",
      "owner_repo": "lotus-platform/lotus-workbench/lotus-gateway",
      "implemented": false,
      "metric_type": "counter",
      "labels": ["route", "panel", "attention_type", "severity"],
      "purpose": "planned bounded attention counter for actionable user-visible degradation"
    }
  ],
  "telemetry_contract": {
    "severity_levels": ["info", "warning", "action_required", "critical"],
    "attention_event_types": [
      "panel_stale",
      "panel_degraded",
      "panel_repeated_failure",
      "source_partial",
      "permission_blocked"
    ],
    "audit_event_types": [
      "analytics_read_allowed",
      "analytics_read_denied",
      "protected_diagnostics_lookup"
    ],
    "browser_events": [
      {
        "event_name": "workbench.analytics.panel_hydration",
        "owner_repo": "lotus-workbench",
        "implemented": false,
        "attributes": ["route", "panel", "state", "freshness_bucket", "status_class"],
        "purpose": "planned browser-side panel hydration event for certified analytics panels"
      },
      {
        "event_name": "workbench.analytics.panel_state",
        "owner_repo": "lotus-workbench",
        "implemented": false,
        "attributes": ["route", "panel", "state", "reason", "severity"],
        "purpose": "planned browser-side state transition event for certified analytics panels"
      },
      {
        "event_name": "workbench.analytics.api_request",
        "owner_repo": "lotus-workbench",
        "implemented": false,
        "attributes": ["route", "operation", "status_class", "error_category"],
        "purpose": "planned Workbench BFF/API request event for analytics reads"
      }
    ],
    "gateway_log_events": [
      {
        "event_name": "gateway.analytics.fanout.completed",
        "owner_repo": "lotus-gateway",
        "implemented": true,
        "attributes": [
          "route",
          "operation",
          "service",
          "state",
          "status_class",
          "supportability_state"
        ],
        "purpose": "implementation-backed product-safe structured log for analytics fan-out completion"
      },
      {
        "event_name": "gateway.analytics.fanout.degraded",
        "owner_repo": "lotus-gateway",
        "implemented": true,
        "attributes": [
          "route",
          "operation",
          "service",
          "state",
          "reason",
          "supportability_state",
          "status_class",
          "error_category"
        ],
        "purpose": "implementation-backed product-safe structured log for degraded analytics fan-out"
      }
    ],
    "trace_attributes": [
      "route",
      "panel",
      "service",
      "operation",
      "state",
      "freshness_bucket",
      "supportability_state",
      "status_class",
      "error_category"
    ],
    "attention_event_attributes": [
      "route",
      "panel",
      "attention_type",
      "severity",
      "state",
      "reason",
      "freshness_bucket",
      "supportability_state"
    ],
    "audit_event_attributes": [
      "route",
      "panel",
      "operation",
      "state",
      "reason",
      "status_class",
      "region",
      "environment"
    ],
    "dashboard_reference_policy": {
      "implemented_metrics_only": true,
      "forbidden_variables": [
        "portfolio_id",
        "client_id",
        "client_name",
        "household_id",
        "account_id",
        "instrument_id",
        "holding_id",
        "transaction_id",
        "trace_id",
        "correlation_id",
        "document_id",
        "advisor_id",
        "advisor_behavior",
        "screen_content",
        "request_body",
        "response_body",
        "raw_entitlement_failure"
      ]
    },
    "alert_reference_policy": {
      "implemented_metrics_only": true,
      "forbidden_annotations": [
        "portfolio_id",
        "client_id",
        "client_name",
        "household_id",
        "account_id",
        "instrument_id",
        "holding_id",
        "transaction_id",
        "trace_id",
        "correlation_id",
        "document_id",
        "advisor_id",
        "advisor_behavior",
        "screen_content",
        "request_body",
        "response_body",
        "raw_entitlement_failure"
      ]
    },
    "protected_diagnostics_policy": {
      "metrics_must_not_carry_lookup_identifiers": true,
      "operator_lookup_requires_protected_api": true,
      "raw_request_response_capture_allowed": false
    }
  },
  "dashboards": [],
  "alerts": [],
