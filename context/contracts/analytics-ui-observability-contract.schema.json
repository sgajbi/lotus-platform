{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lotus.platform/contracts/analytics-ui-observability-contract.schema.json",
  "type": "object",
  "required": [
    "contract_id",
    "contract_version",
    "governed_by_rfc",
    "lifecycle_status",
    "allowed_labels",
    "forbidden_fields",
    "state_vocabulary",
    "metric_families",
    "telemetry_contract",
    "dashboards",
    "alerts",
    "supported_feature_keys",
    "evidence_requirements",
    "scaffold_requirements"
  ],
  "properties": {
    "contract_id": { "const": "analytics-ui-observability-contract" },
    "contract_version": { "type": "string" },
    "governed_by_rfc": { "const": "RFC-0108" },
    "lifecycle_status": {
      "enum": [
        "implementation-not-started",
        "slice-0-implemented",
        "slice-1-structure-implemented",
        "slice-2-telemetry-contract-implemented",
        "slice-3-correlation-propagation-implemented",
        "slice-4-structured-logging-implemented",
        "slice-5-metrics-dashboard-implemented",
        "slice-6-attention-events-implemented",
        "slice-7-audit-events-implemented",
        "slice-8-canonical-proof-implemented",
        "slice-9-rollout-readiness-implemented",
        "second-last-hardening-implemented"
      ]
    },
    "allowed_labels": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "forbidden_fields": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "state_vocabulary": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "metric_families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric_name",
          "owner_repo",
          "implemented",
          "metric_type",
          "labels",
          "purpose"
        ],
        "properties": {
          "metric_name": { "type": "string" },
          "owner_repo": { "type": "string" },
          "implemented": { "type": "boolean" },
          "metric_type": { "enum": ["counter", "gauge", "histogram"] },
          "labels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "purpose": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "dashboards": {
      "type": "array",
      "items": { "type": "object" }
    },
    "telemetry_contract": {
      "type": "object",
      "required": [
        "severity_levels",
        "attention_event_types",
        "audit_event_types",
        "browser_events",
        "gateway_log_events",
        "trace_attributes",
        "attention_event_attributes",
        "audit_event_attributes",
        "dashboard_reference_policy",
        "alert_reference_policy",
        "protected_diagnostics_policy"
      ],
      "properties": {
        "severity_levels": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "attention_event_types": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "audit_event_types": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "browser_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/telemetryEvent" },
          "minItems": 1
        },
        "gateway_log_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/telemetryEvent" },
          "minItems": 1
        },
        "trace_attributes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "attention_event_attributes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "audit_event_attributes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "dashboard_reference_policy": {
          "type": "object",
          "required": ["implemented_metrics_only", "forbidden_variables"],
          "properties": {
            "implemented_metrics_only": { "const": true },
            "forbidden_variables": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "alert_reference_policy": {
          "type": "object",
          "required": ["implemented_metrics_only", "forbidden_annotations"],
          "properties": {
            "implemented_metrics_only": { "const": true },
            "forbidden_annotations": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "protected_diagnostics_policy": {
          "type": "object",
          "required": [
            "metrics_must_not_carry_lookup_identifiers",
            "operator_lookup_requires_protected_api",
            "raw_request_response_capture_allowed"
          ],
          "properties": {
            "metrics_must_not_carry_lookup_identifiers": { "const": true },
            "operator_lookup_requires_protected_api": { "const": true },
            "raw_request_response_capture_allowed": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "alerts": {
      "type": "array",
      "items": { "type": "object" }
    },
    "supported_feature_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature_key", "status", "owner_repo", "promotion_evidence"],
        "properties": {
          "feature_key": { "type": "string" },
          "status": { "enum": ["planned", "implemented"] },
          "owner_repo": { "type": "string" },
          "promotion_evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence_requirements": {
      "type": "object",
      "required": ["artifact_types", "required_identifiers", "forbidden_content_classes"],
      "properties": {
        "artifact_types": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "required_identifiers": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "forbidden_content_classes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "scaffold_requirements": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "$defs": {
    "telemetryEvent": {
      "type": "object",
      "required": ["event_name", "owner_repo", "implemented", "attributes", "purpose"],
      "properties": {
        "event_name": { "type": "string" },
        "owner_repo": { "type": "string" },
        "implemented": { "type": "boolean" },
        "attributes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "purpose": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
