{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lotus.platform/contracts/analytics-ui-observability-ecosystem-final-closure.schema.json",
  "type": "object",
  "required": [
    "contract_id",
    "contract_version",
    "governed_by_rfc",
    "lifecycle_status",
    "closure_scope",
    "source_contracts",
    "implemented_slice_status",
    "supported_features_audit",
    "residual_scope",
    "proof_reconciliation",
    "downstream_boundary_hardening",
    "local_proof_commands",
    "required_github_checks",
    "wiki_publication",
    "branch_hygiene",
    "skills_guidance_review"
  ],
  "properties": {
    "contract_id": {
      "const": "analytics-ui-observability-ecosystem-final-closure"
    },
    "contract_version": { "type": "string" },
    "governed_by_rfc": { "const": "RFC-0108" },
    "lifecycle_status": {
      "const": "slice-18-ecosystem-final-closure-implemented"
    },
    "closure_scope": {
      "type": "object",
      "required": [
        "implemented_scope_status",
        "supported_features_policy",
        "residual_scope_policy"
      ],
      "properties": {
        "implemented_scope_status": { "const": "closed_for_implemented_scope" },
        "supported_features_policy": { "const": "implementation_backed_only" },
        "residual_scope_policy": { "const": "planned_until_separately_implemented" }
      },
      "additionalProperties": false
    },
    "source_contracts": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "implemented_slice_status": {
      "type": "object",
      "additionalProperties": {
        "enum": ["implemented", "partially_implemented", "planned"]
      }
    },
    "supported_features_audit": {
      "type": "object",
      "required": [
        "policy",
        "implemented_feature_keys_reviewed",
        "planned_feature_keys_reviewed"
      ],
      "properties": {
        "policy": { "const": "implementation_backed_only" },
        "implemented_feature_keys_reviewed": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "planned_feature_keys_reviewed": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "residual_scope": {
      "type": "array",
      "items": { "$ref": "#/$defs/residualScopeItem" },
      "minItems": 1
    },
    "proof_reconciliation": {
      "type": "object",
      "required": [
        "ecosystem_proof_contract",
        "ecosystem_hardening_contract",
        "protected_diagnostics_reviewed",
        "dashboard_alerts_reviewed",
        "no_sensitive_content_reviewed",
        "no_open_p0_p1_reviewed"
      ],
      "properties": {
        "ecosystem_proof_contract": { "const": "analytics-ui-observability-ecosystem-proof" },
        "ecosystem_hardening_contract": { "const": "analytics-ui-observability-ecosystem-hardening" },
        "protected_diagnostics_reviewed": { "const": true },
        "dashboard_alerts_reviewed": { "const": true },
        "no_sensitive_content_reviewed": { "const": true },
        "no_open_p0_p1_reviewed": { "const": true }
      },
      "additionalProperties": false
    },
    "downstream_boundary_hardening": {
      "type": "object",
      "required": [
        "status",
        "gateway_pr",
        "gateway_merge_commit",
        "gateway_wiki_publish_commit",
        "lotus_manage_allowed_paths",
        "lotus_advise_proposal_paths",
        "forbidden_gateway_patterns",
        "ownership_decision",
        "local_proof",
        "github_checks"
      ],
      "properties": {
        "status": { "const": "implemented" },
        "gateway_pr": { "const": 179 },
        "gateway_merge_commit": { "type": "string", "minLength": 7 },
        "gateway_wiki_publish_commit": { "type": "string", "minLength": 7 },
        "lotus_manage_allowed_paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 3
        },
        "lotus_advise_proposal_paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "forbidden_gateway_patterns": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "ownership_decision": { "type": "string", "minLength": 1 },
        "local_proof": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "github_checks": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "local_proof_commands": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_github_checks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "wiki_publication": {
      "type": "object",
      "required": [
        "source_repository",
        "check_required",
        "publish_required_after_merge",
        "publish_command"
      ],
      "properties": {
        "source_repository": { "const": "lotus-platform" },
        "check_required": { "const": true },
        "publish_required_after_merge": { "const": true },
        "publish_command": { "type": "string" }
      },
      "additionalProperties": false
    },
    "branch_hygiene": {
      "type": "object",
      "required": ["branch_name", "one_pr_per_slice", "delete_after_merge"],
      "properties": {
        "branch_name": { "type": "string" },
        "one_pr_per_slice": { "const": true },
        "delete_after_merge": { "const": true }
      },
      "additionalProperties": false
    },
    "skills_guidance_review": {
      "type": "object",
      "required": ["decision", "rationale", "reviewed_guidance"],
      "properties": {
        "decision": { "enum": ["no_change_required", "changed"] },
        "rationale": { "type": "string" },
        "reviewed_guidance": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "residualScopeItem": {
      "type": "object",
      "required": ["feature_key", "status", "owner_repo", "reason"],
      "properties": {
        "feature_key": { "type": "string" },
        "status": { "const": "planned" },
        "owner_repo": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
