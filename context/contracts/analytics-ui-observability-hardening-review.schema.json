{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lotus.platform/contracts/analytics-ui-observability-hardening-review.schema.json",
  "type": "object",
  "required": [
    "contract_id",
    "contract_version",
    "governed_by_rfc",
    "lifecycle_status",
    "review_scope",
    "telemetry_field_review",
    "panel_state_review",
    "api_certification_review",
    "dashboard_certification_review",
    "enterprise_governance_review",
    "findings",
    "residual_scope",
    "required_local_commands",
    "required_github_checks"
  ],
  "properties": {
    "contract_id": { "const": "analytics-ui-observability-hardening-review" },
    "contract_version": { "type": "string" },
    "governed_by_rfc": { "const": "RFC-0108" },
    "lifecycle_status": { "const": "second-last-hardening-implemented" },
    "review_scope": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewScopeItem" },
      "minItems": 1
    },
    "telemetry_field_review": {
      "type": "object",
      "required": [
        "source_contract",
        "allowed_label_policy",
        "forbidden_field_policy",
        "runtime_events_reviewed"
      ],
      "properties": {
        "source_contract": { "const": "analytics-ui-observability-contract" },
        "allowed_label_policy": { "const": "contract_only" },
        "forbidden_field_policy": { "const": "deny_all_forbidden_fields" },
        "runtime_events_reviewed": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "panel_state_review": {
      "type": "object",
      "required": [
        "source_contract",
        "source_registry",
        "certified_route_groups_reviewed",
        "non_telemetry_registry_states"
      ],
      "properties": {
        "source_contract": { "const": "analytics-ui-observability-contract" },
        "source_registry": { "const": "workbench-panel-registry" },
        "certified_route_groups_reviewed": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "non_telemetry_registry_states": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "api_certification_review": {
      "type": "array",
      "items": { "$ref": "#/$defs/apiCertificationItem" },
      "minItems": 1
    },
    "dashboard_certification_review": {
      "type": "object",
      "required": [
        "dashboard_id",
        "alert_ids",
        "implemented_metrics_only",
        "runbook_paths_required"
      ],
      "properties": {
        "dashboard_id": { "type": "string" },
        "alert_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "implemented_metrics_only": { "const": true },
        "runbook_paths_required": { "const": true }
      },
      "additionalProperties": false
    },
    "enterprise_governance_review": {
      "type": "object",
      "required": [
        "supported_features_policy",
        "sensitive_content_policy",
        "mesh_standards_posture"
      ],
      "properties": {
        "supported_features_policy": { "const": "implementation_backed_only" },
        "sensitive_content_policy": { "const": "no_sensitive_content" },
        "mesh_standards_posture": { "const": "no_new_domain_product_or_mesh_api" }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" },
      "minItems": 1
    },
    "residual_scope": {
      "type": "array",
      "items": { "$ref": "#/$defs/residualScopeItem" }
    },
    "required_local_commands": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_github_checks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "$defs": {
    "reviewScopeItem": {
      "type": "object",
      "required": ["area", "status", "evidence"],
      "properties": {
        "area": { "type": "string" },
        "status": { "enum": ["passed", "not_applicable", "planned_residual"] },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "apiCertificationItem": {
      "type": "object",
      "required": [
        "surface",
        "owner_repo",
        "changed_by_rfc0108",
        "openapi_required",
        "certification_status",
        "evidence"
      ],
      "properties": {
        "surface": { "type": "string" },
        "owner_repo": { "type": "string" },
        "changed_by_rfc0108": { "type": "boolean" },
        "openapi_required": { "type": "boolean" },
        "certification_status": {
          "enum": ["certified", "not_applicable", "planned_residual"]
        },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "severity", "status", "summary", "evidence"],
      "properties": {
        "finding_id": { "type": "string" },
        "severity": { "enum": ["P0", "P1", "P2", "P3"] },
        "status": { "enum": ["closed", "planned_residual"] },
        "summary": { "type": "string" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "residualScopeItem": {
      "type": "object",
      "required": ["feature_key", "status", "owner_repo", "reason"],
      "properties": {
        "feature_key": { "type": "string" },
        "status": { "const": "planned" },
        "owner_repo": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
