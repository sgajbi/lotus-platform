{
  "contract_id": "reporting-observability-contract",
  "contract_version": "1.0.0",
  "governed_by_rfc": "RFC-0105",
  "metrics_catalog": [
    {
      "metric_name": "lotus_report_operations_total",
      "owner_repo": "lotus-report",
      "implemented": true,
      "metric_type": "counter",
      "labels": ["operation", "status", "failure_category"],
      "cardinality_policy": "bounded-enum-only",
      "purpose": "bounded report, snapshot, render handoff, archive handoff, worker, and scheduler operation counts"
    },
    {
      "metric_name": "lotus_report_operation_duration_seconds",
      "owner_repo": "lotus-report",
      "implemented": true,
      "metric_type": "histogram",
      "labels": ["operation", "status", "failure_category"],
      "cardinality_policy": "bounded-enum-only",
      "purpose": "bounded report operation duration histogram"
    },
    {
      "metric_name": "lotus_report_batch_runtime_last_items",
      "owner_repo": "lotus-report",
      "implemented": true,
      "metric_type": "gauge",
      "labels": ["item_state"],
      "cardinality_policy": "bounded-enum-only",
      "purpose": "last bounded worker-pass item counts"
    },
    {
      "metric_name": "lotus_report_batch_scheduler_last_schedules",
      "owner_repo": "lotus-report",
      "implemented": true,
      "metric_type": "gauge",
      "labels": ["outcome"],
      "cardinality_policy": "bounded-enum-only",
      "purpose": "last bounded scheduler-pass schedule counts"
    },
    {
      "metric_name": "lotus_report_batch_pressure_last_counts",
      "owner_repo": "lotus-report",
      "implemented": true,
      "metric_type": "gauge",
      "labels": ["pressure_state"],
      "cardinality_policy": "bounded-enum-only",
      "purpose": "durable batch pressure counts for runnable, active, dispatch-ready, retry-ready, and recovery-pending work"
    },
    {
      "metric_name": "lotus_render_operations_total",
      "owner_repo": "lotus-render",
      "implemented": true,
      "metric_type": "counter",
      "labels": ["operation", "status", "failure_category"],
      "cardinality_policy": "bounded-enum-only",
      "purpose": "bounded render submission and lookup operation counts"
    },
    {
      "metric_name": "lotus_render_operation_duration_seconds",
      "owner_repo": "lotus-render",
      "implemented": true,
      "metric_type": "histogram",
      "labels": ["operation", "status", "failure_category"],
      "cardinality_policy": "bounded-enum-only",
      "purpose": "bounded render operation duration histogram"
    },
    {
      "metric_name": "lotus_render_artifact_size_bytes",
      "owner_repo": "lotus-render",
      "implemented": true,
      "metric_type": "histogram",
      "labels": ["status"],
      "cardinality_policy": "bounded-enum-only",
      "purpose": "render artifact size histogram"
    },
    {
      "metric_name": "lotus_archive_operations_total",
      "owner_repo": "lotus-archive",
      "implemented": true,
      "metric_type": "counter",
      "labels": ["operation", "status", "failure_category"],
      "cardinality_policy": "bounded-enum-only",
      "purpose": "bounded archive lifecycle and retrieval operation counts"
    },
    {
      "metric_name": "lotus_archive_operation_duration_seconds",
      "owner_repo": "lotus-archive",
      "implemented": true,
      "metric_type": "histogram",
      "labels": ["operation", "status", "failure_category"],
      "cardinality_policy": "bounded-enum-only",
      "purpose": "bounded archive operation duration histogram"
    },
    {
      "metric_name": "lotus_archive_document_size_bytes",
      "owner_repo": "lotus-archive",
      "implemented": true,
      "metric_type": "histogram",
      "labels": ["status"],
      "cardinality_policy": "bounded-enum-only",
      "purpose": "archive document size histogram"
    }
  ],
  "dashboards": [
    {
      "dashboard_id": "reporting-operations-overview",
      "title": "Reporting Operations Overview",
      "metric_names": [
        "lotus_report_operations_total",
        "lotus_report_operation_duration_seconds",
        "lotus_render_operations_total",
        "lotus_render_operation_duration_seconds",
        "lotus_archive_operations_total",
        "lotus_archive_operation_duration_seconds"
      ]
    },
    {
      "dashboard_id": "reporting-batch-pressure",
      "title": "Reporting Batch Pressure",
      "metric_names": [
        "lotus_report_batch_runtime_last_items",
        "lotus_report_batch_scheduler_last_schedules",
        "lotus_report_batch_pressure_last_counts"
      ]
    },
    {
      "dashboard_id": "reporting-artifact-volume",
      "title": "Reporting Artifact Volume",
      "metric_names": [
        "lotus_render_artifact_size_bytes",
        "lotus_archive_document_size_bytes"
      ]
    }
  ],
  "alerts": [
    {
      "alert_id": "report-operation-failures",
      "metric_name": "lotus_report_operations_total",
      "severity": "P2",
      "owner_repo": "lotus-report",
      "runbook_path": "docs/operations/reporting-observability-runbook.md#report-operation-failures",
      "threshold_summary": "Alert when failed report operations exceed 5 per 15 minutes in the reporting path."
    },
    {
      "alert_id": "render-latency-p95",
      "metric_name": "lotus_render_operation_duration_seconds",
      "severity": "P2",
      "owner_repo": "lotus-render",
      "runbook_path": "docs/operations/reporting-observability-runbook.md#render-latency-p95",
      "threshold_summary": "Alert when p95 render duration exceeds 5 seconds for 15 minutes."
    },
    {
      "alert_id": "archive-latency-p95",
      "metric_name": "lotus_archive_operation_duration_seconds",
      "severity": "P2",
      "owner_repo": "lotus-archive",
      "runbook_path": "docs/operations/reporting-observability-runbook.md#archive-latency-p95",
      "threshold_summary": "Alert when p95 archive duration exceeds 2 seconds for 15 minutes."
    },
    {
      "alert_id": "batch-dispatch-ready-backlog",
      "metric_name": "lotus_report_batch_pressure_last_counts",
      "severity": "P2",
      "owner_repo": "lotus-report",
      "runbook_path": "docs/operations/reporting-observability-runbook.md#batch-dispatch-ready-backlog",
      "threshold_summary": "Alert when dispatch-ready batch items exceed 100 for 15 minutes."
    },
    {
      "alert_id": "batch-retry-ready-pressure",
      "metric_name": "lotus_report_batch_pressure_last_counts",
      "severity": "P3",
      "owner_repo": "lotus-report",
      "runbook_path": "docs/operations/reporting-observability-runbook.md#batch-retry-ready-pressure",
      "threshold_summary": "Alert when retry-ready batch items exceed 25 for 15 minutes."
    }
  ],
  "sla_objectives": [
    {
      "objective_id": "report-operation-reliability",
      "service_scope": "lotus-report request, worker, and downstream handoff path",
      "metric_name": "lotus_report_operations_total",
      "target_summary": "Failed report operations stay at or below 5 per rolling 15-minute window.",
      "measurement_window": "15m rolling",
      "owner_repo": "lotus-report",
      "escalation_owner_role": "reporting-service-owner",
      "runbook_path": "docs/operations/reporting-observability-runbook.md#initial-sla-objectives-and-escalation-owners"
    },
    {
      "objective_id": "render-latency-objective",
      "service_scope": "lotus-render package submission and artifact lookup path",
      "metric_name": "lotus_render_operation_duration_seconds",
      "target_summary": "Render duration p95 remains at or below 5 seconds over a rolling 15-minute window.",
      "measurement_window": "15m rolling",
      "owner_repo": "lotus-render",
      "escalation_owner_role": "render-service-owner",
      "runbook_path": "docs/operations/reporting-observability-runbook.md#initial-sla-objectives-and-escalation-owners"
    },
    {
      "objective_id": "archive-latency-objective",
      "service_scope": "lotus-archive create, metadata lookup, and retention lookup path",
      "metric_name": "lotus_archive_operation_duration_seconds",
      "target_summary": "Archive duration p95 remains at or below 2 seconds over a rolling 15-minute window.",
      "measurement_window": "15m rolling",
      "owner_repo": "lotus-archive",
      "escalation_owner_role": "archive-service-owner",
      "runbook_path": "docs/operations/reporting-observability-runbook.md#initial-sla-objectives-and-escalation-owners"
    },
    {
      "objective_id": "batch-dispatch-backlog-objective",
      "service_scope": "lotus-report batch dispatch-ready queue health",
      "metric_name": "lotus_report_batch_pressure_last_counts",
      "target_summary": "Dispatch-ready batch items remain at or below 100 for a rolling 15-minute window.",
      "measurement_window": "15m rolling",
      "owner_repo": "lotus-report",
      "escalation_owner_role": "reporting-service-owner",
      "runbook_path": "docs/operations/reporting-observability-runbook.md#initial-sla-objectives-and-escalation-owners"
    },
    {
      "objective_id": "batch-retry-pressure-objective",
      "service_scope": "lotus-report retry-ready queue health",
      "metric_name": "lotus_report_batch_pressure_last_counts",
      "target_summary": "Retry-ready batch items remain at or below 25 for a rolling 15-minute window.",
      "measurement_window": "15m rolling",
      "owner_repo": "lotus-report",
      "escalation_owner_role": "reporting-service-owner",
      "runbook_path": "docs/operations/reporting-observability-runbook.md#initial-sla-objectives-and-escalation-owners"
    }
  ],
  "deferred_alerts": [
    {
      "alert_family": "stuck_jobs",
      "deferred_to_slice": "Slice 8",
      "reason": "RFC-0105 Slice 8 owns stuck-state metrics and scanner-backed thresholds."
    },
    {
      "alert_family": "sla_breaches",
      "deferred_to_slice": "Slice 8",
      "reason": "RFC-0105 Slice 8 owns SLA breach metrics, attention events, and simulation proof."
    }
  ]
}
