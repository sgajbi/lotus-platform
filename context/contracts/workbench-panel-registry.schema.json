{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lotus.dev/contracts/workbench-panel-registry.schema.json",
  "title": "Workbench Panel Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "governed_by_rfc",
    "canonical_data_contract",
    "panels"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "const": "workbench-panel-registry"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "governed_by_rfc": {
      "type": "string",
      "const": "RFC-0077"
    },
    "related_rfcs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "canonical_data_contract": {
      "type": "string",
      "const": "canonical-front-office-demo-data-contract"
    },
    "panels": {
      "type": "array",
      "minItems": 12,
      "items": {
        "$ref": "#/$defs/panelEntry"
      }
    }
  },
  "$defs": {
    "panelState": {
      "type": "string",
      "enum": [
        "ready",
        "loading",
        "empty",
        "partial",
        "unavailable",
        "error",
        "out_of_scope"
      ]
    },
    "validationRuleMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ready": { "type": "array", "items": { "type": "string" } },
        "loading": { "type": "array", "items": { "type": "string" } },
        "empty": { "type": "array", "items": { "type": "string" } },
        "partial": { "type": "array", "items": { "type": "string" } },
        "unavailable": { "type": "array", "items": { "type": "string" } },
        "error": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "screenshotPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_required",
        "screenshot_name"
      ],
      "properties": {
        "capture_required": { "type": "boolean" },
        "screenshot_name": { "type": ["string", "null"] }
      }
    },
    "panelEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_id",
        "display_name",
        "screen_id",
        "route",
        "panel_kind",
        "panel_level",
        "parent_panel_id",
        "owning_service",
        "gateway_endpoint",
        "canonical_data_contract",
        "required_support_state",
        "allowed_states",
        "validation_rules",
        "screenshot_policy",
        "evidence_required",
        "methodology_reference",
        "known_limitations",
        "out_of_scope_reason",
        "owner_follow_up_rfc"
      ],
      "properties": {
        "panel_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
        },
        "display_name": { "type": "string", "minLength": 1 },
        "screen_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "panel_kind": {
          "type": "string",
          "enum": [
            "summary_panel",
            "detail_panel",
            "analytic_panel",
            "evidence_panel",
            "workflow_panel"
          ]
        },
        "panel_level": {
          "type": "string",
          "enum": [
            "panel",
            "subpanel"
          ]
        },
        "parent_panel_id": { "type": ["string", "null"] },
        "owning_service": {
          "type": "string",
          "enum": [
            "lotus-gateway",
            "lotus-advise",
            "lotus-ai",
            "lotus-manage",
            "lotus-performance",
            "lotus-risk"
          ]
        },
        "gateway_endpoint": { "type": ["string", "null"] },
        "canonical_data_contract": {
          "type": "string",
          "const": "canonical-front-office-demo-data-contract"
        },
        "required_support_state": { "$ref": "#/$defs/panelState" },
        "allowed_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/panelState" }
        },
        "validation_rules": { "$ref": "#/$defs/validationRuleMap" },
        "screenshot_policy": { "$ref": "#/$defs/screenshotPolicy" },
        "evidence_required": { "type": "boolean" },
        "methodology_reference": { "type": ["string", "null"] },
        "known_limitations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "out_of_scope_reason": { "type": ["string", "null"] },
        "owner_follow_up_rfc": { "type": ["string", "null"] }
      }
    }
  }
}
