{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sgajbi/lotus-platform/platform-contracts/cost-attribution/service-cost-attribution.schema.json",
  "title": "Lotus Service Cost Attribution Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "repository", "proofScope", "claimPosture", "service",
    "billingPeriod", "currency", "generatedAtUtc", "provenance", "billingSource",
    "resourceObservation", "allocations", "sharedCostAllocation", "reconciliation",
    "costAttributionReconciled", "costAttributionCertified", "certificationBlockers",
    "supportedFeaturePromoted"
  ],
  "properties": {
    "schemaVersion": { "const": "lotus-platform.service-cost-attribution.v1" },
    "repository": { "const": "lotus-platform" },
    "proofScope": { "const": "source_safe_service_cost_attribution" },
    "claimPosture": { "enum": ["reconciled_not_attested", "reconciliation_blocked"] },
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "serviceId", "environment", "region"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "serviceId": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["test", "production-like", "production"] },
        "region": { "type": "string", "minLength": 1 }
      }
    },
    "billingPeriod": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": { "start": { "type": "string", "format": "date" }, "end": { "type": "string", "format": "date" } }
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceCommitSha", "sourceRef", "pipelineRunId"],
      "properties": {
        "sourceCommitSha": { "type": "string", "minLength": 7 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "pipelineRunId": { "type": "string", "minLength": 1 }
      }
    },
    "billingSource": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "exportType", "exportVersion", "exportDigestSha256", "exportedAtUtc"],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "exportType": { "type": "string", "minLength": 1 },
        "exportVersion": { "type": "string", "minLength": 1 },
        "exportDigestSha256": { "$ref": "#/$defs/sha256" },
        "exportedAtUtc": { "type": "string", "format": "date-time" }
      }
    },
    "resourceObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "sha256", "runId"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "runId": { "type": "string", "minLength": 1 }
      }
    },
    "allocations": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "allOf": [
        { "contains": { "properties": { "category": { "const": "compute" } }, "required": ["category"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "category": { "const": "memory" } }, "required": ["category"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "category": { "const": "database" } }, "required": ["category"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "category": { "const": "network" } }, "required": ["category"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "category": { "const": "storage" } }, "required": ["category"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "category": { "const": "observability" } }, "required": ["category"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "category": { "const": "shared_platform" } }, "required": ["category"] }, "minContains": 1, "maxContains": 1 }
      ],
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category", "amount"],
        "properties": {
          "category": { "enum": ["compute", "memory", "database", "network", "storage", "observability", "shared_platform"] },
          "amount": { "$ref": "#/$defs/money" }
        }
      }
    },
    "sharedCostAllocation": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "methodologyVersion", "weight", "rounding", "residualHandling", "residualAmount"],
      "properties": {
        "method": { "const": "proportional_resource_weight" },
        "methodologyVersion": { "const": "lotus-platform.proportional-resource-cost-allocation.v1" },
        "weight": { "type": "string", "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$" },
        "rounding": { "const": "ROUND_HALF_EVEN" },
        "residualHandling": { "const": "assign_to_shared_platform" },
        "residualAmount": { "$ref": "#/$defs/money" }
      }
    },
    "reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceTotal", "allocatedTotal", "expectedWeightedTotal", "variance", "status", "completenessStatus", "freshnessStatus", "partialPeriod", "lateAdjustment"],
      "properties": {
        "sourceTotal": { "$ref": "#/$defs/money" },
        "allocatedTotal": { "$ref": "#/$defs/money" },
        "expectedWeightedTotal": { "$ref": "#/$defs/money" },
        "variance": { "const": "0.00" },
        "status": { "const": "reconciled" },
        "completenessStatus": { "enum": ["complete", "partial", "missing"] },
        "freshnessStatus": { "enum": ["current", "stale"] },
        "partialPeriod": { "type": "boolean" },
        "lateAdjustment": { "type": "boolean" }
      }
    },
    "costAttributionReconciled": { "type": "boolean" },
    "costAttributionCertified": { "const": false },
    "certificationBlockers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "supportedFeaturePromoted": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "money": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{2}$" }
  }
}
