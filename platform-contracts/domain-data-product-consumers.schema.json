{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lotus-platform/contracts/domain-data-product-consumers.schema.json",
  "title": "Lotus Domain Data Product Consumer Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "governed_by_rfc",
    "consumer_repository",
    "dependencies"
  ],
  "properties": {
    "contract_id": { "type": "string", "const": "domain-data-product-consumers" },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "governed_by_rfc": { "type": "string", "const": "RFC-0084" },
    "consumer_repository": { "$ref": "#/$defs/repositoryName" },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dependencyEntry" }
    }
  },
  "$defs": {
    "repositoryName": {
      "type": "string",
      "pattern": "^lotus-[a-z0-9-]+$"
    },
    "consumptionMode": {
      "type": "string",
      "enum": [
        "api_read",
        "paged_api_read",
        "export_job",
        "gateway_composition",
        "supportability_lookup"
      ]
    },
    "failurePosture": {
      "type": "string",
      "enum": ["fail_closed", "degrade_to_partial", "support_only", "best_effort"]
    },
    "validationLane": {
      "type": "string",
      "enum": ["feature", "pr-merge", "main-releasability", "platform-end-to-end"]
    },
    "trustMetadataField": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "migrationPosture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["current", "approved_transition"]
        },
        "target_product_version": {
          "type": ["string", "null"],
          "pattern": "^(v[0-9]+|[0-9]+\\.[0-9]+\\.[0-9]+)$"
        },
        "justification": { "type": ["string", "null"], "minLength": 1 },
        "sunset_condition": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "dependencyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_name",
        "producer_repository",
        "required_product_version",
        "required_trust_metadata",
        "migration_posture",
        "consumption_mode",
        "business_purpose",
        "validation_lanes",
        "failure_posture"
      ],
      "properties": {
        "product_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]+$"
        },
        "producer_repository": { "$ref": "#/$defs/repositoryName" },
        "required_product_version": {
          "type": "string",
          "pattern": "^(v[0-9]+|[0-9]+\\.[0-9]+\\.[0-9]+)$"
        },
        "required_trust_metadata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/trustMetadataField" }
        },
        "migration_posture": { "$ref": "#/$defs/migrationPosture" },
        "consumption_mode": { "$ref": "#/$defs/consumptionMode" },
        "business_purpose": { "type": "string", "minLength": 1 },
        "validation_lanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/validationLane" }
        },
        "failure_posture": { "$ref": "#/$defs/failurePosture" }
      }
    }
  }
}
