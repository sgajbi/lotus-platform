{
  "contract_id": "lotus-mesh-access-policy",
  "contract_version": "1.0.0",
  "governed_by_rfcs": [
    "RFC-0091"
  ],
  "product_id": "lotus-core:DpmSourceReadiness:v1",
  "producer_repository": "lotus-core",
  "default_posture": "restricted",
  "allowed_consumers": [
    {
      "consumer_repository": "lotus-manage",
      "tenant_scope": [
        "TENANT_PRIVATE_BANKING_DEMO"
      ],
      "roles": [
        "operator",
        "portfolio_manager"
      ],
      "use_cases": [
        "dpm_source_readiness",
        "rebalance_precheck"
      ]
    },
    {
      "consumer_repository": "lotus-gateway",
      "tenant_scope": [
        "TENANT_PRIVATE_BANKING_DEMO"
      ],
      "roles": [
        "operator"
      ],
      "use_cases": [
        "discovery",
        "source_readiness_evidence_review"
      ]
    }
  ],
  "denial_posture": {
    "customer_visible_state": "requestable",
    "operator_visible_state": "restricted_with_reason",
    "reason": "DPM source readiness contains portfolio-operating control evidence and requires explicit tenant, role, and use-case authorization."
  },
  "audit": {
    "owner_repository": "lotus-core",
    "policy_owner": "dpm-source-readiness-product-owner",
    "decision_evidence": "access-policy:lotus-core:dpm-source-readiness:v1"
  }
}
