{
  "contract_id": "lotus-mesh-access-policy",
  "contract_version": "1.0.0",
  "governed_by_rfcs": [
    "RFC-0091"
  ],
  "product_id": "lotus-report:ClientReportEvidencePack:v1",
  "producer_repository": "lotus-report",
  "default_posture": "restricted",
  "allowed_consumers": [
    {
      "consumer_repository": "lotus-gateway",
      "tenant_scope": [
        "TENANT_PRIVATE_BANKING_DEMO"
      ],
      "roles": [
        "operator",
        "advisor"
      ],
      "use_cases": [
        "discovery",
        "client_reporting_evidence_review"
      ]
    }
  ],
  "denial_posture": {
    "customer_visible_state": "requestable",
    "operator_visible_state": "restricted_with_reason",
    "reason": "Client report evidence packs contain client-confidential reporting evidence and require explicit tenant and role authorization."
  },
  "audit": {
    "owner_repository": "lotus-report",
    "policy_owner": "reporting-product-owner",
    "decision_evidence": "access-policy:lotus-report:client-report-evidence-pack:v1"
  }
}
