{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lotus-platform.local/platform-contracts/supported-claims/supported-claim-register.schema.json",
  "title": "Lotus Supported Claim Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "governed_by_rfc",
    "owner_repository",
    "scenario_id",
    "primary_portfolio_id",
    "proof_marker",
    "claim_taxonomy",
    "front_office_validation",
    "artifact_policy",
    "claims"
  ],
  "properties": {
    "contract_id": {
      "const": "supported-claim-register"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "governed_by_rfc": {
      "type": "string",
      "pattern": "^RFC-[0-9]{4}$"
    },
    "owner_repository": {
      "type": "string",
      "pattern": "^lotus-[a-z0-9-]+$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "primary_portfolio_id": {
      "type": "string",
      "minLength": 1
    },
    "proof_marker": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "claim_taxonomy": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "enum": [
          "IMPLEMENTATION_BACKED",
          "BACKEND_BACKED_UI_PENDING",
          "DEGRADED_SUPPORTED",
          "PLANNED_RFC",
          "UNSUPPORTED"
        ]
      },
      "uniqueItems": true
    },
    "front_office_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_gateway_backing",
        "requires_browser_validation",
        "required_evidence_markers",
        "required_panels"
      ],
      "properties": {
        "requires_gateway_backing": {
          "type": "boolean"
        },
        "requires_browser_validation": {
          "type": "boolean"
        },
        "required_evidence_markers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "uniqueItems": true
        },
        "required_panels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "artifact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_allowed_artifacts",
        "local_only_artifacts",
        "sensitive_artifact_rules"
      ],
      "properties": {
        "commit_allowed_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "local_only_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sensitive_artifact_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "title",
          "classification",
          "audience",
          "allowed_materials",
          "evidence_refs",
          "wording_rules",
          "proof_requirements",
          "promotion_gate"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "IMPLEMENTATION_BACKED",
              "BACKEND_BACKED_UI_PENDING",
              "DEGRADED_SUPPORTED",
              "PLANNED_RFC",
              "UNSUPPORTED"
            ]
          },
          "audience": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "ENGINEERING",
                "OPERATIONS",
                "SALES",
                "PRE_SALES",
                "RFP_SECURITY",
                "BUSINESS_USER",
                "CLIENT_DEMO"
              ]
            },
            "uniqueItems": true
          },
          "allowed_materials": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "README",
                "WIKI",
                "SUPPORTED_FEATURES",
                "DEMO_SCRIPT",
                "SCREENSHOT",
                "RFP_PACK",
                "SECURITY_PACK",
                "ONE_PAGER",
                "ARCHITECTURE_DECK",
                "ROI_STORY",
                "LINKEDIN_DRAFT"
              ]
            },
            "uniqueItems": true
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "wording_rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proof_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "promotion_gate": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
