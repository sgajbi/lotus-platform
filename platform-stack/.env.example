# Generated values are written to the untracked .env by bootstrap.ps1/bootstrap.sh.
# Existing non-empty .env values are never overwritten.
LOTUS_WORKSPACE_ROOT=
LOTUS_MANAGE_REPO_PATH=
LOTUS_CORE_REPO_PATH=
LOTUS_PERFORMANCE_REPO_PATH=
LOTUS_REPORT_REPO_PATH=
LOTUS_IDEA_REPO_PATH=
LOTUS_GATEWAY_REPO_PATH=
LOTUS_WORKBENCH_REPO_PATH=

# Required secrets (generated once; intentionally empty in the tracked template)
LOTUS_CORE_POSTGRES_PASSWORD=
LOTUS_MANAGE_POSTGRES_PASSWORD=
LOTUS_REPORT_POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Non-secret local database identities
LOTUS_CORE_POSTGRES_DB=portfolio_db
LOTUS_CORE_POSTGRES_USER=lotus_core
LOTUS_MANAGE_POSTGRES_DB=lotus_manage
LOTUS_MANAGE_POSTGRES_USER=lotus_manage
LOTUS_REPORT_POSTGRES_DB=lotus_report
LOTUS_REPORT_POSTGRES_USER=lotus_report
GRAFANA_ADMIN_USER=lotus_operator

# Base stack host ports (loopback-bound by Compose)
DEV_INGRESS_HTTP_PORT=80
DEV_INGRESS_HTTPS_PORT=443
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Optional debug-only direct host ports (also loopback-bound)
LOTUS_MANAGE_PORT=8000
LOTUS_CORE_INGESTION_PORT=8200
LOTUS_CORE_QUERY_PORT=8201
LOTUS_PERFORMANCE_PORT=8002
LOTUS_REPORT_PORT=8300
LOTUS_GATEWAY_PORT=8100
LOTUS_WORKBENCH_PORT=3000
PROMETHEUS_PORT=9190
GRAFANA_PORT=3300
